"""
Map thu gom rac (phong cach so do canh co mui ten 2 chieu).
Xuat (cung thu muc voi file nay):
  map.png              - ban do (moi diem ghi kem h(n))
  tables.png           - bang khoang cach ngan nhat + bang h(n)
  distance_matrix.csv  - ma tran khoang cach

Muon doi map: sua POS (vi tri ve), EDGES (duong + khoang cach), DEPOT, H.
"""
import csv
import math
import os
import textwrap
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Circle

# ----------------------------- CONFIG -----------------------------
DEPOT = "Hoang Hoa Tham"

# ten diem -> (cot, hang) tren khung ve; hang 0 o tren cung
POS = {
    "Phan Dinh Phung": (0, 0), "Hoe Nhai": (1, 0), "Quan Thanh": (2, 0), "Thanh Nien": (3, 0),
    "Hung Vuong": (0, 1), "Hang Than": (1, 1), "Hoang Hoa Tham": (2, 1), "Nui Truc": (3, 1),
    "Giang Vo": (1, 2), "Ngoc Khanh": (2, 2),
}

# duong 2 chieu: (diem 1, diem 2, khoang cach - so nguyen, don vi m)
EDGES = [
    ("Phan Dinh Phung", "Hoe Nhai", 18), ("Hoe Nhai", "Quan Thanh", 22), ("Quan Thanh", "Thanh Nien", 15),
    ("Hung Vuong", "Hang Than", 20), ("Hang Than", "Hoang Hoa Tham", 14), ("Hoang Hoa Tham", "Nui Truc", 18),
    ("Giang Vo", "Ngoc Khanh", 21),
    ("Phan Dinh Phung", "Hung Vuong", 25), ("Hoe Nhai", "Hang Than", 16), ("Quan Thanh", "Hoang Hoa Tham", 12),
    ("Thanh Nien", "Nui Truc", 28), ("Hang Than", "Giang Vo", 26), ("Hoang Hoa Tham", "Ngoc Khanh", 24),
    # duong cheo
    ("Phan Dinh Phung", "Hang Than", 30), ("Hung Vuong", "Giang Vo", 28), ("Quan Thanh", "Nui Truc", 24),
]

# h(n): uoc luong chi phi tu diem n ve Depot. Depot = 0, cac diem khac <= 30, khong trung nhau.
H = {
    "Hoang Hoa Tham": 0,
    "Quan Thanh": 10,
    "Hang Than": 12,
    "Nui Truc": 16,
    "Ngoc Khanh": 20,
    "Thanh Nien": 24,
    "Phan Dinh Phung": 26,
    "Hoe Nhai": 27,
    "Hung Vuong": 29,
    "Giang Vo": 30,
}

BASE = os.path.dirname(os.path.abspath(__file__))   # thu muc chua file code
OUT_MAP = os.path.join(BASE, "map.png")
OUT_TABLES = os.path.join(BASE, "tables.png")
OUT_CSV = os.path.join(BASE, "distance_matrix.csv")

NODE_COLOR, DEPOT_COLOR = "#87CEEB", "#F4A261"
SP, R = 3.2, 0.9          # khoang cach giua cac o luoi / ban kinh nut (don vi ve)
# ------------------------------------------------------------------

NAMES = list(POS)
BINS = [n for n in NAMES if n != DEPOT]


def shortest_paths():
    """Floyd-Warshall: khoang cach ngan nhat (so nguyen) giua moi cap diem."""
    INF = 10 ** 9
    D = {a: {b: (0 if a == b else INF) for b in NAMES} for a in NAMES}
    for a, b, w in EDGES:
        D[a][b] = D[b][a] = min(D[a][b], w)
    for k in NAMES:
        for i in NAMES:
            for j in NAMES:
                if D[i][k] + D[k][j] < D[i][j]:
                    D[i][j] = D[i][k] + D[k][j]
    assert all(D[a][b] < INF for a in NAMES for b in NAMES), "Do thi khong lien thong!"
    return D


def h(current, unvisited=None, D=None, depot=DEPOT):
    """h(n) tra ve tu bang H (chi phu thuoc vi tri hien tai; cac tham so con lai
    giu lai de tuong thich voi gbfs.py). h(Depot) = 0."""
    return H[current]


def check_h(D):
    """Kiem tra rang buoc cua de bai va tinh hop le cua h."""
    assert H[DEPOT] == 0, "h(Depot) phai bang 0"
    assert set(H) == set(NAMES), "H thieu hoac thua diem"
    others = [H[n] for n in NAMES if n != DEPOT]
    assert all(v <= 30 for v in others), "co h(n) > 30"
    assert len(set(H.values())) == len(H), "co h(n) trung nhau"
    # admissible: h(n) <= quang duong that ve Depot (nho hon chi phi con lai that)
    for n in NAMES:
        assert H[n] <= D[n][DEPOT], f"h({n}) vuot khoang cach that ve Depot"
    # consistent: |h(u) - h(v)| <= w(u, v) tren moi canh
    for a, b, w in EDGES:
        assert abs(H[a] - H[b]) <= w, f"h khong nhat quan tren canh {a}-{b}"


def xy(name):
    c, r = POS[name]
    return (c * SP, -r * SP)


def draw_map():
    fig, ax = plt.subplots(figsize=(10, 8.2))
    for a, b, w in EDGES:
        (x1, y1), (x2, y2) = xy(a), xy(b)
        dx, dy = x2 - x1, y2 - y1
        L = math.hypot(dx, dy)
        ux, uy = dx / L, dy / L
        s = (x1 + ux * R, y1 + uy * R)
        e = (x2 - ux * R, y2 - uy * R)
        ax.annotate("", xy=e, xytext=s, zorder=1,
                    arrowprops=dict(arrowstyle="<|-|>", color="gray", lw=1.6,
                                    mutation_scale=18, shrinkA=0, shrinkB=0))
        ang = math.degrees(math.atan2(dy, dx))
        if ang > 90:
            ang -= 180
        elif ang <= -90:
            ang += 180
        ax.text((x1 + x2) / 2, (y1 + y2) / 2, f"{w}m", rotation=ang, rotation_mode="anchor",
                ha="center", va="center", fontsize=10, zorder=2,
                bbox=dict(fc="white", ec="none", pad=1.5))

    for n in NAMES:
        x, y = xy(n)
        ax.add_patch(Circle((x, y), R, fc=DEPOT_COLOR if n == DEPOT else NODE_COLOR,
                            ec="none", zorder=3))
        ax.text(x, y, f"{textwrap.fill(n, 10)}\nh = {H[n]}", ha="center", va="center",
                fontsize=10, zorder=4, linespacing=1.3)

    ax.scatter([], [], s=200, color=DEPOT_COLOR, label="Depot (tram tap ket)")
    ax.scatter([], [], s=200, color=NODE_COLOR, label="Thung rac")
    ax.legend(loc="lower left", frameon=False, fontsize=10)
    ax.set_title("Map", fontsize=14)
    ax.set_aspect("equal")
    ax.set_xlim(-R - 0.6, 3 * SP + R + 0.6)
    ax.set_ylim(-2 * SP - R - 0.6, R + 0.6)
    ax.axis("off")
    fig.savefig(OUT_MAP, dpi=160, bbox_inches="tight", facecolor="white")
    plt.close(fig)


def draw_tables(D):
    wrapped = [textwrap.fill(n, 9) for n in NAMES]
    fig = plt.figure(figsize=(17, 6.5))

    ax1 = fig.add_axes([0.0, 0.02, 0.68, 0.88])
    ax1.axis("off")
    ax1.set_title("Khoang cach ngan nhat giua cac diem (m)", fontsize=12)
    t1 = ax1.table(cellText=[[str(D[a][b]) for b in NAMES] for a in NAMES],
                   rowLabels=wrapped, colLabels=wrapped, loc="center", cellLoc="center")
    t1.auto_set_font_size(False)
    t1.set_fontsize(9)
    t1.scale(1, 2.0)
    for (r, c), cell in t1.get_celld().items():
        if r == 0 or c == -1:
            cell.set_facecolor("#eef3f7")

    ax2 = fig.add_axes([0.70, 0.02, 0.29, 0.88])
    ax2.axis("off")
    ax2.set_title("Bang h(n)", fontsize=12)
    rows = [[n + (" (Depot)" if n == DEPOT else ""), str(H[n]), str(D[n][DEPOT])]
            for n in NAMES]
    t2 = ax2.table(cellText=rows, colLabels=["Diem", "h(n)", "Khoang cach\nthat ve Depot"],
                   loc="center", cellLoc="center")
    t2.auto_set_font_size(False)
    t2.set_fontsize(10)
    t2.scale(1, 1.9)
    t2.auto_set_column_width([0, 1, 2])
    for (r, c), cell in t2.get_celld().items():
        if r == 0:
            cell.set_facecolor("#eef3f7")

    fig.savefig(OUT_TABLES, dpi=160, bbox_inches="tight", facecolor="white")
    plt.close(fig)


def main():
    D = shortest_paths()
    check_h(D)
    with open(OUT_CSV, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow([""] + NAMES)
        for a in NAMES:
            w.writerow([a] + [D[a][b] for b in NAMES])
    draw_map()
    draw_tables(D)
    print("Da luu:", OUT_MAP, OUT_TABLES, OUT_CSV)
    print("Kiem tra h(n): h(Depot)=0, cac diem khac <= 30, khong trung, admissible, nhat quan: OK")


if __name__ == "__main__":
    main()
